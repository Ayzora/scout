# Your own Anthropic API key. Scout never sends it anywhere except api.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Reasoning model. Opus 5.5 is the default; see docs for cheaper options.
SCOUT_MODEL=claude-opus-5-5

# low | medium | high | xhigh | max  — raises thoroughness and cost together.
SCOUT_EFFORT=high

# Advisory token ceiling per company, so the agent paces itself. Minimum 20000.
SCOUT_TASK_BUDGET_TOKENS=120000

# Show the browser window while researching. Set to true to watch the agent work.
SCOUT_HEADED=true

# Hard safety stops per company.
SCOUT_MAX_STEPS=60
SCOUT_PAGE_TIMEOUT_MS=20000

# Where the database and screenshots live.
SCOUT_DATA_DIR=./data
