# Your own Anthropic API key. Scout never sends it anywhere except api.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# How the agent reaches pages. All three record into the same schema, so a run of
# each on one company is directly comparable -- which is the point of having them.
#   browser          A real Chromium driven by Playwright, through Scout's own seven
#                    tools. Sees JavaScript-rendered content and can click through to
#                    pages that have no URL of their own.
#   fetch            No browser. Server-side web_search and web_fetch only, i.e.
#                    conventional scripted research. Cheaper per page, and blind to
#                    whatever a scraper is blind to.
#   browser_toolset  The same Playwright browser behind Anthropic's
#                    browser_toolset_20260801 interface. Built to measure whether its
#                    standard vocabulary navigates better than Scout's own; no
#                    evidence either way yet.
SCOUT_ENGINE=browser

# How much research to do, as a count of separate branches rather than a bigger budget
# for one conversation. A single conversation re-reads its history every turn, so its
# cost grows with the square of its length; branches grow linearly.
#   shallow   1 branch, as before the tree existed
#   standard  4 branches, the main areas researched separately
#   deep      6 branches plus up to 4 follow-ups on organisations it finds
# One company at standard depth measured $0.087 for 69 findings.
SCOUT_DEPTH=standard

# Reasoning model. Haiku 5.5 is the default because it is what the measurements
# support: repricing one real run (57 findings over 9 pages) gave $1.14 on
# claude-opus-5-5, $0.57 on claude-sonnet-5-5 and $0.034 on claude-haiku-5-5 --
# 34x apart for identical work. Step up if a company needs it.
SCOUT_MODEL=claude-haiku-5-5

# Synthesis turns recorded findings into the final profile. It reads no pages and can
# add no information, so it is the safest place to run a cheap model. Defaults to
# SCOUT_MODEL when unset.
# SCOUT_SYNTHESIS_MODEL=claude-haiku-5-5

# low | medium | high | xhigh | max  — raises thoroughness and cost together.
# Haiku 5.5's own default is medium, and its levels are calibrated for itself, so
# don't carry a value over from another model without re-measuring.
SCOUT_EFFORT=medium

# Advisory token ceiling per *branch*, so each one paces itself. Minimum 20000.
# The run as a whole is capped at this times the branches the depth allows, so a deep
# run has a stated ceiling rather than an open-ended one.
SCOUT_TASK_BUDGET_TOKENS=40000

# Show the browser window while researching. Set to true to watch the agent work.
# Ignored by the fetch engine, which never opens one.
SCOUT_HEADED=true

# Optional. A free Companies House API key, from
# https://developer.company-information.service.gov.uk/
#
# With it, `lookup_registry` queries the register directly: exact, free, and stronger
# than anything a web search returns. Without it Scout hands the agent the public
# search URL to read instead, rather than guessing a registration number.
COMPANIES_HOUSE_API_KEY=

# Check robots.txt before navigating. On by default.
#
# Turning it off is an operator decision and changes nothing else: Scout still refuses
# to solve CAPTCHAs, still never logs in, and still reports a bot-protection challenge
# instead of working around it. Note that a site may allow crawling and still block an
# unfamiliar client -- that is the firewall talking, not robots.txt.
SCOUT_RESPECT_ROBOTS=true

# Clearing old tool results from context. Off on purpose: it is a context-window
# tool, not a saving. Every clearing pass rewrites the conversation the cache was
# built from, so the next turn pays to write it all again -- Anthropic's own measured
# run found it cost more than it saved. Turn it on only for runs that approach the
# context window.
SCOUT_CONTEXT_EDITING=false

# Hard safety stops per company.
SCOUT_MAX_STEPS=60
SCOUT_PAGE_TIMEOUT_MS=20000

# Where the database and screenshots live.
SCOUT_DATA_DIR=./data
