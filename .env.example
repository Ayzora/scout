# Your own Anthropic API key. Scout never sends it anywhere except api.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# How the agent reaches pages.
#   browser  A real Chromium, driven by Playwright. Sees JavaScript-rendered content
#            and can click through to pages that have no URL of their own.
#   fetch    No browser. Server-side web_search and web_fetch only -- conventional
#            scripted research. Cheaper per page, blind to anything a scraper is
#            blind to. Built for comparison; see docs.
SCOUT_ENGINE=browser

# Reasoning model. Haiku 5.5 is the default because it is what the measurements
# support: repricing one real run (57 findings over 9 pages) gave $1.14 on
# claude-opus-5-5, $0.57 on claude-sonnet-5-5 and $0.034 on claude-haiku-5-5 --
# 34x apart for identical work. Step up if a company needs it.
SCOUT_MODEL=claude-haiku-5-5

# Synthesis turns recorded findings into the final profile. It reads no pages and can
# add no information, so it is the safest place to run a cheap model. Defaults to
# SCOUT_MODEL when unset.
# SCOUT_SYNTHESIS_MODEL=claude-haiku-5-5

# low | medium | high | xhigh | max  — raises thoroughness and cost together.
# Haiku 5.5's own default is medium, and its levels are calibrated for itself, so
# don't carry a value over from another model without re-measuring.
SCOUT_EFFORT=medium

# Advisory token ceiling per company, so the agent paces itself. Minimum 20000.
# This is the main scope throttle. At 120000 the agent kept going well past the
# objective: one run returned 57 findings and 9 people, four of them non-executive
# directors, for "what do they sell, and who leads the company?".
SCOUT_TASK_BUDGET_TOKENS=40000

# Show the browser window while researching. Set to true to watch the agent work.
# Ignored by the fetch engine, which never opens one.
SCOUT_HEADED=true

# Clearing old tool results from context. Off on purpose: it is a context-window
# tool, not a saving. Every clearing pass rewrites the conversation the cache was
# built from, so the next turn pays to write it all again -- Anthropic's own measured
# run found it cost more than it saved. Turn it on only for runs that approach the
# context window.
SCOUT_CONTEXT_EDITING=false

# Hard safety stops per company.
SCOUT_MAX_STEPS=60
SCOUT_PAGE_TIMEOUT_MS=20000

# Where the database and screenshots live.
SCOUT_DATA_DIR=./data
